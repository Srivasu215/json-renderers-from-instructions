{
  "base": {
    "tagName": "div",
    "attributes": {
      "class": "row g-4",
      "data-role": "selects-container"
    },
    "children": []
  },
  "spec": {
    "buildSelectCard": {
      "tagName": "div",
      "attributes": {
        "class": "col-md-4 mb-3"
      },
      "children": [
        {
          "tagName": "div",
          "attributes": {
            "class": "card shadow-sm border-0 h-100"
          },
          "children": [
            {
              "tagName": "div",
              "attributes": {
                "class": "card-header bg-dark text-white d-flex justify-content-between align-items-center py-2 px-3"
              },
              "children": [
                {
                  "tagName": "span",
                  "textContent": "${label}",
                  "attributes": {
                    "class": "fw-bold small text-uppercase"
                  }
                },
                {
                  "tagName": "span",
                  "textContent": "${columnName}",
                  "attributes": {
                    "class": "badge bg-secondary font-monospace"
                  }
                }
              ]
            },
            {
              "tagName": "div",
              "attributes": {
                "class": "card-body p-3"
              },
              "children": [
                {
                  "tagName": "label",
                  "textContent": "Select ${label}:",
                  "attributes": {
                    "for": "select-${columnName}",
                    "class": "form-label text-muted small fw-semibold"
                  }
                },
                {
                  "tagName": "select",
                  "attributes": {
                    "id": "select-${columnName}",
                    "name": "${columnName}",
                    "class": "form-select form-select-lg border-2 shadow-none"
                  },
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    "buildOption": {
      "tagName": "option",
      "textContent": "${rowValue}",
      "attributes": {
        "value": "${rowValue}"
      }
    }
  },
  "single": [
    {
      "narration": "Build select cards from columns",
      "destinationPath": {
        "fileName": "base",
        "filePath": ["children"]
      },
      "sourcePath": {
        "fileName": "data",
        "filePath": ["columns"]
      },
      "templateKey": "buildSelectCard",
      "func": "fromCollection"
    },
    {
      "narration": "Build options for Item Name select",
      "destinationPath": {
        "fileName": "base",
        "filePath": ["children", 0, "children", 0, "children", 1, "children", 1, "children"]
      },
      "sourcePath": {
        "fileName": "data",
        "filePath": ["itemNameOptions"]
      },
      "templateKey": "buildOption",
      "func": "fromCollection"
    },
    {
      "narration": "Build options for Category select",
      "destinationPath": {
        "fileName": "base",
        "filePath": ["children", 1, "children", 0, "children", 1, "children", 1, "children"]
      },
      "sourcePath": {
        "fileName": "data",
        "filePath": ["categoryOptions"]
      },
      "templateKey": "buildOption",
      "func": "fromCollection"
    },
    {
      "narration": "Build options for Base Unit select",
      "destinationPath": {
        "fileName": "base",
        "filePath": ["children", 2, "children", 0, "children", 1, "children", 1, "children"]
      },
      "sourcePath": {
        "fileName": "data",
        "filePath": ["baseUnitOptions"]
      },
      "templateKey": "buildOption",
      "func": "fromCollection"
    }
  ],
  "double": []
}
